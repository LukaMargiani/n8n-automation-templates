    {
      "parameters": {
        "jsCode": "// 1. Get input\nconst firecrawlInput = $input.first().json;\n// Handle cases where 'links' is undefined or empty\nconst foundLinks = firecrawlInput.links || firecrawlInput.data?.links || [];\n\n// 2. Get original data\nconst originalData = $('Loop Over Organisations').item.json;\nconst originalLink = originalData['Website URL'] || originalData['Career Page'];\n\nlet bestLink = originalLink; // Default to what we have\n\n// 3. If we actually found new links, try to find a better one\nif (foundLinks.length > 0) {\n    // Filter for relevant keywords\n    const keywords = [\n        'career', 'job', 'vacanc', 'recruit', 'position',           'opening', 'opportunit', 'hiring', 'join', \n        'fellowship', 'internship', 'call', 'application',\n        'carriere', 'emplois', 'karriere', 'stellen',               'trabajo', 'vacature', 'tyopaikat', 'lediga'\n    ];\n    const candidates = foundLinks.filter(link => \n        keywords.some(k => link.toLowerCase().includes(k))\n    );\n\n    if (candidates.length > 0) {\n        // Pick the shortest one (likely the main index page)\n        candidates.sort((a, b) => a.length - b.length);\n        bestLink = candidates[0];\n    }\n}\n\n// 4. Output\nreturn {\n    json: {\n        new_career_url: bestLink,\n        id: originalData.id\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
