    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "=gpt-5-mini",
          "mode": "id"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a Grant Analyst for {{ORGANISATION_NAME}}. Its mission: {{ORGANISATION_MISSION}}.\n\nI will give you one EU funding call. Analyse the Title and Description, then:\n  1. Give it a Relevance Score (0-10) for alignment with that mission.\n  2. Write a one-sentence \"why it matters\" summary.\n  3. Extract the programme / type of action.\n\nDo not inflate scores to be helpful. A low score with a clear reason is more useful\nthan a high score that wastes a researcher's afternoon.\n\nReturn only JSON: { \"title\": \"...\", \"programme/type of action\": \"...\", \"score\": 8, \"summary\": \"...\" }"
            },
            {
              "content": "=Please analyze this EU Funding Call:\n\n**Topic/Title:** {{ $json.content }}\n\n**Programme/Type of Action:** {{ $json.metadata.actions }}\n\n**Specific Scope & Expected Outcomes:** {{ $json.metadata.descriptionByte[0] }}\n\nBased on this text, generate the JSON output as requested in the system instructions."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2,
      "position": [
        1120,
        16
      ],
      "id": "e748aa0e-0a97-423b-8c79-36d9853afdf6",
      "name": "Score Relevance",
      "credentials": {
